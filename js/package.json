  },
  "keywords": [
    "busy light",
    "status light",
    "do not disturb",
    "plugin"
  ],
  "homepage": "https://thebusymeter.com",
  "author": "The Busy Meter authors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RIPBillyMays/busy-meter-plugins.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/RIPBillyMays/busy-meter-plugins/issues"
  },
  "dependencies": {}
